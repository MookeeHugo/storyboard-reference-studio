{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "signCommand": {
        "cmd": "node",
        "args": ["../scripts/sign-windows.js", "--file", "%1", "--tauri"]
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
